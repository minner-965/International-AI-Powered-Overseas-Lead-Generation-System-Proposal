# Copy to .env.phase7-outreach only after the company approves a provider.
# Loaded by the dashboard and outreach worker; keep credentials in ignored local files.
OUTREACH_ENABLED=false
LIVE_PROSPECT_SEND_APPROVED=false
# Legacy transport execution boundary, also reused by Phase13 first-touch.
# Automatic delivery requires the independent persisted first-touch policy.
OUTREACH_SEND_SCOPE=DISABLED
CONTROLLED_TEST_MODE=false
CONTROLLED_TEST_MAX_MESSAGES=0
CONTROLLED_TEST_RECIPIENT_ALLOWLIST=
MAIL_PROVIDER_VENDOR=OQUMAIL
# The committed template remains closed. Select SMTP/IMAP only in the ignored local file.
OUTBOUND_EMAIL_PROVIDER=NONE
INBOUND_EMAIL_PROVIDER=NONE
GMAIL_API_ENABLED=false
GMAIL_INBOUND_SYNC_ENABLED=false
GMAIL_SENDER_EMAIL=
GMAIL_REPLY_TO_EMAIL=
GMAIL_UNSUBSCRIBE_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_CONTROLLED_TEST_MODE=true
GMAIL_CONTROLLED_RECIPIENT_ALLOWLIST=
GMAIL_USE_CASE_APPROVED=false
GMAIL_INBOUND_SYNC_INTERVAL_MINUTES=5
GMAIL_AMBIGUOUS_WAIT_SECONDS=120
GMAIL_MESSAGE_ID_DOMAIN=dpvinternational.com
RESEND_USE_CASE=DISABLED
OUTREACH_MAX_SENDS_PER_MINUTE=1
OUTREACH_MAX_SENDS_PER_DAY=10
OUTREACH_MAX_SENDS_PER_COMPANY_30D=2
# One mailbox-verification freshness setting (days). OUTREACH_VERIFICATION_TTL_DAYS is still read as a fallback.
CONTACT_VERIFICATION_TTL_DAYS=90
OUTREACH_PROVIDER_MAX_ATTEMPTS=3
OUTBOUND_EMAIL_TIMEOUT_MS=10000
HUNTER_MODE=DISABLED
HUNTER_API_KEY=
HUNTER_API_ENDPOINT=https://api.hunter.io/v2
HUNTER_REQUEST_TIMEOUT_MS=12000
MAX_HUNTER_CREDITS_PER_RUN_UNITS=20000
MAX_HUNTER_CREDITS_PER_BILLING_PERIOD_UNITS=20000
RESEND_API_KEY=
# OquMail: port 587 starts in plaintext and must upgrade through STARTTLS.
# Do not use SSL/TLS immediately on port 587.
SMTP_HOST=mail.oqumail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_ENABLED=false
SMTP_IMAP_INBOUND_SYNC_ENABLED=false
INBOUND_EMAIL_SYNC_INTERVAL_MINUTES=2
IMAP_UIDVALIDITY_RESCAN_WINDOW=100
SMTP_CONTROLLED_TEST_MODE=true
SMTP_USE_CASE_APPROVED=false
SMTP_USER=
SMTP_PASSWORD=
# First-touch display name comes from the approved template set (Simon).
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_UNSUBSCRIBE_EMAIL=
SMTP_MESSAGE_ID_DOMAIN=
SMTP_CONTROLLED_RECIPIENT_ALLOWLIST=
IMAP_HOST=mail.oqumail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX=INBOX
IMAP_SENT_MAILBOX=Sent
# Optional local-only identifier used by the read-only capability probe. Leave blank in shared templates.
OQUMAIL_SMOKE_MESSAGE_ID=
CRM_BASE_URL=
CRM_API_KEY=
CRM_TIMEOUT_MS=10000
# CRM_PROVIDER=feishu sends the follow-up log to a Feishu Bitable table.
# Column names are set in config/crm/feishu-bitable-map.json.
CRM_PROVIDER=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# Follow-up email drafts after a first touch (each draft needs approval before sending).
CRM_FOLLOWUP_DRAFTS_ENABLED=false
CRM_FOLLOWUP_MAX_SEQUENCE=3
CRM_FOLLOWUP_DAILY_LIMIT=50
# CRM_FOLLOWUP_DRAFTS_ENABLED / CRM_FOLLOWUP_DAILY_LIMIT are only the initial values: once the follow-up
# settings are saved on the settings page (migration 072) the page decides.
# Manual companies and first-touch test sends (batch 2 B1/B2). Comma-separated addresses SIM may use as test
# recipients (test companies may only receive mail at these addresses). Empty = own mailbox only.
TEST_RECIPIENT_ALLOWLIST=
# At most this many "[TEST]" first emails per sender per day.
FIRST_TOUCH_TEST_DAILY_LIMIT=10
