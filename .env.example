# Copy this file to .env on the deployment computer and replace placeholders.
# Never commit the completed .env file.

TZ=Asia/Shanghai
GENERIC_TIMEZONE=Asia/Shanghai

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lead_generation
POSTGRES_USER=leadgen_app
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# AI provider
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
LLM_MODEL=REPLACE_WITH_MODEL_NAME

# Search, company-data and contact-enrichment providers
SEARCH_API_KEY=REPLACE_WITH_SEARCH_PROVIDER_KEY
ENRICHMENT_API_KEY=REPLACE_WITH_ENRICHMENT_PROVIDER_KEY

# Phase 2 internal ResearchJob orchestration
N8N_RESEARCH_WEBHOOK_URL=http://n8n:5678/webhook/dpv-phase1-research
N8N_ENRICHMENT_WEBHOOK_URL=http://n8n:5678/webhook/dpv-phase6-enrichment
N8N_CATEGORY_PROCUREMENT_WEBHOOK_URL=http://n8n:5678/webhook/dpv-phase6-1-category-procurement-match
N8N_WEBHOOK_TIMEOUT_MS=5000
APP_INTERNAL_BASE_URL=http://demo-dashboard:3000
INTERNAL_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_TOKEN

# Phase 5 durable background jobs and bounded local tracing.
PGBOSS_ENABLED=true
OTEL_ENABLED=true

# Phase 3 low-cost search discovery. Tavily key is backend-only.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
# Optional inactive provider credentials.
DATAFORSEO_LOGIN=REPLACE_WITH_DATAFORSEO_API_LOGIN
DATAFORSEO_PASSWORD=REPLACE_WITH_DATAFORSEO_API_PASSWORD
# Brave remains an optional adapter. This confirmation applies only when SEARCH_PROVIDER=brave.
BRAVE_SEARCH_API_KEY=REPLACE_WITH_BRAVE_SEARCH_API_KEY
SEARCH_STORAGE_RIGHTS_CONFIRMED=false
SEARCH_RESULTS_PER_QUERY=5
SEARCH_MAX_QUERIES_PER_JOB=5
SEARCH_REQUEST_TIMEOUT_MS=15000
CONTACT_CHECK_MAX_CANDIDATES=5
CONTACT_CHECK_MAX_PAGES_PER_CANDIDATE=4
CONTACT_FETCH_TIMEOUT_MS=10000
CONTACT_FETCH_DELAY_MS=500
CONTACT_MAX_RESPONSE_BYTES=2000000
CONTACT_USER_AGENT=DPVLeadResearchDemo/1.0

# Phase 4 bounded company verification and optional public business-social search.
COMPANY_VERIFY_MAX_CANDIDATES=5
COMPANY_VERIFY_MAX_PAGES=8
COMPANY_VERIFY_TIMEOUT_MS=10000
COMPANY_VERIFY_DELAY_MS=350
COMPANY_VERIFY_MAX_RESPONSE_BYTES=2000000
SOCIAL_ENRICHMENT_MAX_SEARCHES_PER_JOB=3

# Phase 6 buyer/procurement enrichment. Hunter remains optional.
ENRICHMENT_MAX_COMPANIES=100
ENRICHMENT_MAX_QUERIES_PER_COMPANY=5
ENRICHMENT_MAX_PAGES_PER_COMPANY=6
HUNTER_MODE=DISABLED
HUNTER_API_KEY=
HUNTER_API_ENDPOINT=https://api.hunter.io/v2
HUNTER_REQUEST_TIMEOUT_MS=12000
MAX_HUNTER_CREDITS_PER_RUN_UNITS=20000
MAX_HUNTER_CREDITS_PER_BILLING_PERIOD_UNITS=20000
LINKEDIN_DISCOVERY_MODE=SEARCH_DISCOVERY_ONLY
LINKEDIN_OFFICIAL_API_APPROVED=false
LINKEDIN_OFFICIAL_API_TOKEN=
LINKEDIN_CRAWL_PERMISSION_ID=
LINKEDIN_CRAWL_PERMISSION_EXPIRES_AT=
LINKEDIN_CRAWL_ALLOWED_PATHS=

# Phase 6.1 bounded public category/buyer evidence and local matching.
CATEGORY_PROCUREMENT_MAX_QUERIES_PER_PROFILE=4
CATEGORY_PROCUREMENT_MAX_QUERIES_PER_COMPANY=8
CATEGORY_PROCUREMENT_MAX_PAGES_PER_COMPANY=12
CATEGORY_PROCUREMENT_MAX_DISCOVERY_DEPTH=2
PRODUCT_OPPORTUNITY_MAX_CANDIDATES=20

# Phase 7 controlled outreach. Both approval switches remain false until a
# separate company-approved live pilot is authorized.
OUTREACH_ENABLED=false
LIVE_PROSPECT_SEND_APPROVED=false
OUTBOUND_EMAIL_PROVIDER=NONE
INBOUND_EMAIL_PROVIDER=NONE
OUTREACH_ALLOWED_MARKETS=AE,MX
OUTREACH_MAX_SENDS_PER_MINUTE=1
OUTREACH_MAX_SENDS_PER_DAY=10
OUTREACH_MAX_SENDS_PER_COMPANY_30D=2
OUTREACH_VERIFICATION_TTL_DAYS=30
ALLOW_ACCEPT_ALL_SEND=false
RESEND_USE_CASE=DISABLED
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CORPORATE_EMAIL_WEBHOOK_SECRET=
DPV_MANAGEMENT_API_TOKEN=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_MANAGEMENT_TOKEN
DPV_MANAGEMENT_API_ACTOR=local-demo
DPV_MANAGEMENT_API_ROLE=MANAGEMENT
DPV_MANAGEMENT_TOKEN_BINDINGS=
DPV_MANAGEMENT_CSRF_SECRET=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_CSRF_SECRET

# Phase 7 local runtime exchange directories. Shared-folder source paths are
# never mounted into application containers.
DATA_EXCHANGE_STAGING_DIR=/app/runtime/phase7/staging
DATA_EXCHANGE_EXPORT_DIR=/app/runtime/phase7/exports
DATA_IMPORT_MAX_FILE_BYTES=20971520
DATA_IMPORT_MAX_ROWS=10000
DATA_IMPORT_MAX_COLUMNS=100
DATA_IMPORT_MAX_CELL_CHARS=32768
DATA_EXPORT_DOWNLOAD_TTL_SECONDS=900
DATA_EXPORT_FILE_TTL_SECONDS=3600

# Email / CRM. SMTP is inactive while OUTBOUND_EMAIL_PROVIDER=NONE.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CRM_BASE_URL=REPLACE_WITH_CRM_URL
CRM_API_KEY=REPLACE_WITH_CRM_KEY

