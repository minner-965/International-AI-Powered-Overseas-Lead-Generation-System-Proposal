# Copy this file to .env on the deployment computer and replace placeholders.
# Never commit the completed .env file.

TZ=Asia/Shanghai
GENERIC_TIMEZONE=Asia/Shanghai

# Workspace port on this computer (http://localhost:<port>). sq-system uses 3000, so this defaults to 3100.
DASHBOARD_PORT=3100

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lead_generation
POSTGRES_USER=leadgen_app
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Internal non-ResearchJob orchestration
N8N_ENRICHMENT_WEBHOOK_URL=http://n8n:5678/webhook/dpv-phase6-enrichment
N8N_CATEGORY_PROCUREMENT_WEBHOOK_URL=http://n8n:5678/webhook/dpv-phase6-1-category-procurement-match
N8N_WEBHOOK_TIMEOUT_MS=5000
N8N_AUTO_EVIDENCE_WORKFLOW_ACTIVE=false
ORCHESTRATOR_QUEUED_THRESHOLD_MINUTES=10
ORCHESTRATOR_RETRY_DELAY_MINUTES=5
APP_INTERNAL_BASE_URL=http://demo-dashboard:3000
INTERNAL_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_TOKEN

# Phase 5 durable background jobs and bounded local tracing.
PGBOSS_ENABLED=true
OTEL_ENABLED=true

# Phase 3 low-cost search discovery. Tavily key is backend-only.
SEARCH_PROVIDER=tavily
# Exa is selected explicitly through deployment configuration and research controls.
EXA_ENABLED=false
EXA_API_KEY=
EXA_SEARCH_ENDPOINT=https://api.exa.ai/search
EXA_CAPACITY_RETRY_HOURS=24
# Enable only after Brave credentials and result-storage rights are confirmed.
# false preserves the configured legacy provider; true routes discovery to Brave and evidence to Tavily Advanced.
SEARCH_DUAL_ROUTING_ENABLED=false
TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
# Optional inactive provider credentials.
DATAFORSEO_LOGIN=REPLACE_WITH_DATAFORSEO_API_LOGIN
DATAFORSEO_PASSWORD=REPLACE_WITH_DATAFORSEO_API_PASSWORD
# Brave remains an optional adapter. This confirmation applies only when SEARCH_PROVIDER=brave.
BRAVE_SEARCH_API_KEY=REPLACE_WITH_BRAVE_SEARCH_API_KEY
SEARCH_STORAGE_RIGHTS_CONFIRMED=false
SEARCH_REQUEST_TIMEOUT_MS=15000
# Search spend control. Unit prices are configurable estimates in USD per executed query
# (check the provider's current price list); provider-reported cost is used when available.
SEARCH_COST_USD_PER_QUERY_EXA=0.007
SEARCH_COST_USD_PER_QUERY_TAVILY=0.008
# A research batch whose plan exceeds this many queries is refused (HTTP 409).
SEARCH_MAX_QUERIES_PER_BATCH=300
# Month-to-date search spend cap (UTC calendar month). New batches are refused and queued work pauses at the cap.
SEARCH_MAX_USD_PER_MONTH=30
# Identical query text + market + language + provider executed within this many days is reused at zero cost (0 disables).
SEARCH_REUSE_DAYS=30
CONTACT_CHECK_MAX_PAGES_PER_CANDIDATE=4
CONTACT_FETCH_TIMEOUT_MS=10000
CONTACT_FETCH_DELAY_MS=500
CONTACT_MAX_RESPONSE_BYTES=2000000
CONTACT_USER_AGENT=SIMLeadResearch/1.0

# Phase 4 bounded company verification and optional public business-social search.
COMPANY_VERIFY_MAX_PAGES=8
COMPANY_VERIFY_TIMEOUT_MS=10000
COMPANY_VERIFY_DELAY_MS=350
COMPANY_VERIFY_MAX_RESPONSE_BYTES=2000000

# Phase 6 buyer/procurement enrichment. Hunter remains optional.
ENRICHMENT_MAX_COMPANIES=100
ENRICHMENT_MAX_QUERIES_PER_COMPANY=5
ENRICHMENT_MAX_PAGES_PER_COMPANY=6
HUNTER_MODE=DISABLED
HUNTER_API_KEY=
HUNTER_API_ENDPOINT=https://api.hunter.io/v2
HUNTER_REQUEST_TIMEOUT_MS=12000
MAX_HUNTER_CREDITS_PER_RUN_UNITS=20000
MAX_HUNTER_CREDITS_PER_BILLING_PERIOD_UNITS=20000
MAX_HUNTER_CREDITS_PER_DAY_UNITS=20000
LINKEDIN_DISCOVERY_MODE=SEARCH_DISCOVERY_ONLY
LINKEDIN_OFFICIAL_API_APPROVED=false
LINKEDIN_OFFICIAL_API_TOKEN=
LINKEDIN_CRAWL_PERMISSION_ID=
LINKEDIN_CRAWL_PERMISSION_EXPIRES_AT=
LINKEDIN_CRAWL_ALLOWED_PATHS=

# Phase 6.1 bounded public category/buyer evidence and local matching.
CATEGORY_PROCUREMENT_MAX_QUERIES_PER_PROFILE=4
CATEGORY_PROCUREMENT_MAX_QUERIES_PER_COMPANY=8
CATEGORY_PROCUREMENT_MAX_PAGES_PER_COMPANY=12
CATEGORY_PROCUREMENT_MAX_DISCOVERY_DEPTH=2

# Phase 10 automatic evidence remains inactive until the deployment canary passes.
# Invalid values stop application startup and report only the affected key name.
AUTO_EVIDENCE_ENABLED=false
RESEARCH_CREATION_MAINTENANCE=false
AUTO_EVIDENCE_OPERATOR_OVERRIDE_ENABLED=false
# Minimum 5 minutes.
AUTO_EVIDENCE_RECONCILE_MINUTES=30
AUTO_EVIDENCE_BATCH_SIZE=10
AUTO_EVIDENCE_SOURCE_TTL_DAYS=90
AUTO_EVIDENCE_STAGE_LEASE_MINUTES=15
AUTO_EVIDENCE_TAVILY_ENABLED=true
AUTO_EVIDENCE_HUNTER_ENABLED=true
# Required policy: no DPV-side quantity/credit caps; Tavily account availability is authoritative.
TAVILY_USAGE_POLICY=PROVIDER_ACCOUNT_ONLY
TAVILY_USAGE_ENDPOINT=https://api.tavily.com/usage
TAVILY_USAGE_REFRESH_INTERVAL_MS=300000

# Legacy manual outreach provisioning defaults; keep disabled until configured.
# Phase13 automatic first-touch uses its separate persisted policy and reservations.
OUTREACH_ENABLED=false
LIVE_PROSPECT_SEND_APPROVED=false
OUTBOUND_EMAIL_PROVIDER=NONE
INBOUND_EMAIL_PROVIDER=NONE
OUTREACH_MAX_SENDS_PER_MINUTE=1
OUTREACH_MAX_SENDS_PER_DAY=10
OUTREACH_MAX_SENDS_PER_COMPANY_30D=2
OUTREACH_VERIFICATION_TTL_DAYS=30
RESEND_USE_CASE=DISABLED
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CORPORATE_EMAIL_WEBHOOK_SECRET=
GMAIL_API_ENABLED=false
GMAIL_INBOUND_SYNC_ENABLED=false
GMAIL_SENDER_EMAIL=
GMAIL_REPLY_TO_EMAIL=
GMAIL_UNSUBSCRIBE_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_CONTROLLED_TEST_MODE=true
GMAIL_CONTROLLED_RECIPIENT_ALLOWLIST=
GMAIL_USE_CASE_APPROVED=false
GMAIL_INBOUND_SYNC_INTERVAL_MINUTES=5
GMAIL_AMBIGUOUS_WAIT_SECONDS=120
GMAIL_MESSAGE_ID_DOMAIN=dpvinternational.com
DPV_WORKSPACE_ACTOR=dpv-workspace
DPV_WORKSPACE_ROLE=MANAGEMENT

# Phase 7 local runtime exchange directories. Shared-folder source paths are
# never mounted into application containers.
DATA_EXCHANGE_STAGING_DIR=/app/runtime/phase7/staging
DATA_EXCHANGE_EXPORT_DIR=/app/runtime/phase7/exports
# Import safety limits are defined by dataExchange/fileContract.js, not env overrides.
DATA_EXPORT_DOWNLOAD_TTL_SECONDS=900
DATA_EXPORT_FILE_TTL_SECONDS=3600

# Email / CRM. SMTP is inactive while OUTBOUND_EMAIL_PROVIDER=NONE.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CRM_BASE_URL=REPLACE_WITH_CRM_URL
CRM_API_KEY=REPLACE_WITH_CRM_KEY

