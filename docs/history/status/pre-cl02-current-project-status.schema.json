{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpvinternational.local/schemas/current-project-status.schema.json",
  "title": "DPV current project status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_updated_at", "repository", "branch", "commit", "dirty_at_snapshot",
    "latest_released_phase", "current_active_phase", "phase_state",
    "final_acceptance_state", "business_result_state", "applied_migrations",
    "current_real_data_counts", "effective_runtime_flags", "required_n8n_workflow_status",
    "last_reconciliation_heartbeat", "provider_configuration", "current_blockers",
    "next_allowed_work_package", "explicit_stop_boundary"
  ],
  "properties": {
    "generated_updated_at": {"type":"string","format":"date-time"},
    "repository": {"type":"string","minLength":1},
    "branch": {"type":"string","minLength":1},
    "commit": {"type":"string","pattern":"^[0-9a-f]{40}$","description":"Existing Git baseline when the snapshot was authored; must be an ancestor of the committed status snapshot."},
    "dirty_at_snapshot": {"type":"boolean","description":"Historical worktree state at snapshot authoring, independent of a later checkout's cleanliness."},
    "latest_released_phase": {"enum":["Phase 10 (Pre-email)","Phase 11 (Controlled outreach)","Phase 12 (Workspace UI)"]},
    "current_active_phase": {"enum":["Phase 10","Phase 11","Phase 12","Phase 13"]},
    "phase13_search":{"type":"object","additionalProperties":false,"required":["scope","wp_mc00","wp_mc01","wp_mc02","stop_after"],"properties":{"scope":{"const":["WP-MC00","WP-MC01","WP-MC02"]},"wp_mc00":{"const":"PASS"},"wp_mc01":{"enum":["IN_PROGRESS","PASS"]},"wp_mc02":{"enum":["IN_PROGRESS","PASS"]},"runtime_activation":{"const":"NOT_ACTIVATED_PENDING_CONFIG"},"live_brave_test":{"const":"NOT_RUN"},"brave_configured":{"const":false},"storage_rights_confirmed":{"const":false},"result_report":{"const":"docs/PHASE13_MC00_02_RESULT.md"},"stop_after":{"const":"WP-MC02"}}},
    "phase13_mc03": {"type":"object","additionalProperties":false,"required":["scope","status","provider_calls","email_sends","business_mutations","applied","company_count","band_counts","result_report","stop_after"],"properties":{"scope":{"const":"WP-MC03"},"status":{"const":"DRY_RUN_COMPLETE_AWAITING_REVIEW"},"provider_calls":{"const":0},"email_sends":{"const":0},"business_mutations":{"const":0},"applied":{"const":false},"company_count":{"type":"integer","minimum":0},"band_counts":{"type":"object"},"result_report":{"const":"docs/PHASE13_MC03_OPPORTUNITY_POOL_DRY_RUN_RESULT.md"},"stop_after":{"const":"WP-MC03"}}},
    "phase13_mc04":{"type":"object","required":["scope","status","user_approved_mc03_bands","provider_calls","email_sends","migration","company_count","active_business_opportunities","result_report","stop_after"],"properties":{"scope":{"const":"WP-MC04"},"status":{"enum":["IN_PROGRESS","PASS"]},"user_approved_mc03_bands":{"const":true},"provider_calls":{"const":0},"email_sends":{"const":0},"migration":{"const":"058_phase13_opportunity_pool.sql"},"company_count":{"type":"integer"},"active_business_opportunities":{"type":"integer"},"result_report":{"const":"docs/PHASE13_MC04_OPPORTUNITY_POOL_RESULT.md"},"stop_after":{"const":"WP-MC04"}}},
    "phase13_mc05":{"type":"object","required":["scope","status","checkpoint_commit","mc04_rule_changes","provider_calls","email_sends","result_report","ui_report","stop_after"],"properties":{"scope":{"const":"WP-MC05"},"status":{"enum":["IN_PROGRESS","PASS"]},"checkpoint_commit":{"type":"string"},"mc04_rule_changes":{"const":0},"provider_calls":{"const":0},"email_sends":{"const":0},"result_report":{"const":"docs/PHASE13_MC05_RESEARCH_BATCH_RESULT.md"},"ui_report":{"const":"docs/PHASE13_MC05_UI_RESULT.md"},"stop_after":{"const":"WP-MC05"}}},
    "phase12_ui": {
      "type":"object", "additionalProperties":false,
      "required":["scope","status","full_phase_acceptance","prior_release_acceptance","stop_after"],
      "properties":{
        "scope":{"const":["WP-UI15","WP-UI16"]},
        "status":{"enum":["CLEANUP_AND_RELEASE_HANDOFF","ACCEPTANCE_COMPLETION"]},
        "full_phase_acceptance":{"enum":["NOT_ACCEPTED","PASS"]},
        "acceptance_report":{"const":"docs/PHASE12_ACCEPTANCE_COMPLETION.md"},
        "accepted_assessment":{"type":"object","additionalProperties":false,"required":["reference","accessibility","human_screen_reader","wcag_certification"],"properties":{"reference":{"const":"PASS"},"accessibility":{"const":"AUTOMATED_AND_BROWSER_ASSESSED"},"human_screen_reader":{"const":"NOT_TESTED"},"wcag_certification":{"const":false}}},
        "release":{"type":"object","additionalProperties":false,"required":["commit","push"],"properties":{"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"push":{"const":"VERIFIED"}}},
        "prior_release_acceptance":{"const":"PASS"},
        "stop_after":{"const":"WP-UI16"}
      },
      "allOf":[{"if":{"properties":{"full_phase_acceptance":{"const":"PASS"}}},"then":{"required":["acceptance_report","accepted_assessment"],"properties":{"status":{"const":"ACCEPTANCE_COMPLETION"}}},"else":{"properties":{"status":{"const":"CLEANUP_AND_RELEASE_HANDOFF"}}}}]
    },
    "phase_state": {
      "type":"array",
      "minItems":4,
      "items":{"type":"string"},
      "allOf":[
        {"contains":{"const":"Phase 1–9 complete"}},
        {"contains":{"const":"Phase 10 code/migration/UI/automation verified"}},
        {"contains":{"const":"Phase 10 pre-email final acceptance passed"}},
        {"contains":{"const":"WP-U00–U14 complete"}}
      ]
    },
    "final_acceptance_state": {"enum":["PASS","INCOMPLETE"]},
    "business_result_state": {"enum":["YES","NO"]},
    "applied_migrations": {
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["migration_key","sha256"],
        "properties":{
          "migration_key":{"type":"string","pattern":"^[0-9]{3}_.+\\.sql$"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        }
      }
    },
    "current_real_data_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "effective_runtime_flags":{"type":"object","additionalProperties":{"type":["boolean","integer","string"]}},
    "required_n8n_workflow_status":{"type":"array","items":{"type":"object"}},
    "last_reconciliation_heartbeat":{
      "type":"object",
      "required":["status","observed_at"],
      "properties":{"status":{"enum":["ACTIVE","STALE","MISSING"]},"observed_at":{"type":["string","null"]}}
    },
    "provider_configuration":{"type":"object"},
    "phase10_1_acceptance":{"type":"object"},
    "phase10_2_acceptance":{"type":"object"},
    "phase10_3_acceptance":{"type":"object"},
    "phase10_4_acceptance":{"type":"object"},
    "phase10_5_acceptance":{"type":"object"},
    "phase11_readiness":{
      "type":"object",
      "required":["scope","wp_oq00","wp_oq01","wp_oq02","wp_oq03","wp_oq04","wp_oq05","wp_oq06","wp_oq07","wp_oq08","wp_oq09","wp_oq10","wp_oq11","wp_oq12","wp_oq13","wp_oq14","wp_oq15","wp_oq16","git_baseline","evidence_summary"],
      "properties":{
        "scope":{"const":["WP-OQ00","WP-OQ01","WP-OQ02","WP-OQ03","WP-OQ04","WP-OQ05","WP-OQ06","WP-OQ07","WP-OQ08","WP-OQ09","WP-OQ10","WP-OQ11","WP-OQ12","WP-OQ13","WP-OQ14","WP-OQ15","WP-OQ16"]},
        "wp_oq00":{"const":"PASS"},
        "wp_oq01":{"const":"PASS"},
        "wp_oq02":{"const":"PASS"},
        "wp_oq03":{"const":"PASS"},
        "wp_oq04":{"const":"PASS"},
        "wp_oq05":{"const":"PASS"},
        "wp_oq06":{"const":"PASS"},
        "wp_oq07":{"const":"PASS"},
        "wp_oq08":{"enum":["PASS","ISOLATED_PERSISTENCE_PASS_REAL_CRM_INCOMPLETE"]},
        "wp_oq09":{"const":"PASS"},
        "wp_oq10":{"enum":["REAL_E2E_PENDING","CONTROLLED_SUBSYSTEM_PASS_CRM_INCOMPLETE","PASS"]},
        "wp_oq11":{"enum":["BLOCKED_BEFORE_SEND","APPROVED_PENDING_SINGLE_SEND","SINGLE_SEND_ACCEPTED_AWAITING_REPLY","PASS"]},
        "wp_oq12":{"enum":["IMPLEMENTED_BROWSER_VERIFIED","PASS"]},
        "wp_oq13":{"enum":["CSV_XLSX_STRUCTURE_PASS","PASS"]},
        "wp_oq14":{"enum":["ISOLATED_PASS_LIVE_FAULTS_UNPROVEN","REGRESSION_PASS_FAULT_FIXTURES","PASS"]},
        "wp_oq15":{"enum":["PARTIAL_DEMO_CRM_INCOMPLETE","FINAL_BROWSER_REVIEW_PENDING","PASS"]},
        "wp_oq16":{"enum":["DOCUMENTS_READY_RELEASE_NOT_EXECUTED","PASS"]},
        "git_baseline":{
          "type":"object",
          "required":["commit","dirty"],
          "properties":{
            "commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
            "dirty":{"const":false}
          }
        },
        "evidence_summary":{"type":"object","minProperties":1}
      }
    },
    "current_blockers":{"type":"array","items":{"type":"string"}},
    "phase13_mc06":{"type":"object","required":["scope","status","checkpoint_commit","search_calls","email_sends","mc07_started","result_report","domain_report","ui_report","stop_after"],"properties":{"scope":{"const":"WP-MC06"},"status":{"enum":["IN_PROGRESS","PASS"]},"search_calls":{"const":0},"email_sends":{"const":0},"mc07_started":{"const":false},"stop_after":{"const":"WP-MC06"}}},
    "phase13_mc07":{"type":"object","additionalProperties":false,"required":["scope","status","automation_master","search_automation","search_runtime_status","opportunity_auto_pool","contact_research_automation","auto_first_touch_email","inbound_reply_monitor","auto_email_followup_sequence","phone_whatsapp_automation","provider_spend_mode","provider_order","search_batch_id","search_scopes","planned_queries","completed_queries","remaining_queries","live_search_started","template_set","sender_display_name","auto_sent","duplicate_sends","result_report","stop_after"],"properties":{"scope":{"const":"MC07_FULL_AUTOMATION"},"status":{"const":"PASS"},"automation_master":{"const":true},"search_automation":{"const":true},"search_runtime_status":{"enum":["HEALTHY","PAUSED_PROVIDER_CAPACITY"]},"opportunity_auto_pool":{"const":true},"contact_research_automation":{"const":true},"auto_first_touch_email":{"const":true},"inbound_reply_monitor":{"const":true},"auto_email_followup_sequence":{"const":false},"phone_whatsapp_automation":{"const":false},"provider_spend_mode":{"const":"NO_NEW_PAID_SPEND"},"provider_order":{"const":["tavily"]},"search_batch_id":{"type":"string","format":"uuid"},"search_scopes":{"const":26},"planned_queries":{"const":579},"completed_queries":{"type":"integer","minimum":0,"maximum":579},"remaining_queries":{"type":"integer","minimum":0,"maximum":579},"live_search_started":{"const":true},"template_set":{"const":"DPV_FIRST_TOUCH_V1"},"sender_display_name":{"const":"Simon"},"auto_sent":{"type":"integer","minimum":1},"duplicate_sends":{"const":0},"result_report":{"const":"docs/PHASE13_MC07_FULL_AUTOMATION_RESULT.md"},"stop_after":{"const":"MC07"}}},
    "next_allowed_work_package":{"enum":["POST_PHASE10_EMAIL_CONFIGURATION","WP-OQ10_CONTROLLED_APPLICATION_CONTEXT_AND_REAL_E2E","WP-OQ11_SINGLE_PILOT_SEND","WP-OQ11_REPLY_AND_CRM_ACCEPTANCE","PHASE11_REMAINING_ACCEPTANCE","STOP_AWAIT_PRODUCTION_POLICY","WP_UI12_UI14_VERIFICATION","WP_MC02_STOP","WP_MC03_REVIEW_STOP","WP_MC04_STOP","WP_MC05_STOP","WP_MC06_STOP","MC07_STOP"]},
    "explicit_stop_boundary":{"type":"string","pattern":"STOP"}
  },
  "allOf":[
    {
      "if":{"properties":{"current_active_phase":{"const":"Phase 11"}}},
      "then":{"properties":{"effective_runtime_flags":{"properties":{"outbound_email_enabled":{"const":false}}}}}
    },
    {
      "if":{"properties":{"current_active_phase":{"enum":["Phase 12","Phase 13"]}}},
      "then":{
        "required":["phase12_ui","phase11_readiness"],
        "properties":{
          "final_acceptance_state":{"enum":["INCOMPLETE","PASS"]},
          "latest_released_phase":{"enum":["Phase 11 (Controlled outreach)","Phase 12 (Workspace UI)"]},
          "next_allowed_work_package":{"enum":["STOP_AWAIT_PRODUCTION_POLICY","WP_MC02_STOP","WP_MC03_REVIEW_STOP","WP_MC04_STOP","WP_MC05_STOP","WP_MC06_STOP","MC07_STOP"]},
          "effective_runtime_flags":{"properties":{"outbound_email_enabled":{"const":true}}}
        }
      },
      "else":{"not":{"required":["phase12_ui"]}}
    },
    {
      "if":{"properties":{"current_active_phase":{"const":"Phase 10"}}},
      "then":{
        "properties":{
          "final_acceptance_state":{"const":"PASS"},
          "business_result_state":{"const":"YES"},
          "next_allowed_work_package":{"const":"POST_PHASE10_EMAIL_CONFIGURATION"}
        },
        "not":{"required":["phase11_readiness"]}
      },
      "else":{
        "required":["phase11_readiness"],
        "properties":{
          "final_acceptance_state":{"enum":["INCOMPLETE","PASS"]},
          "business_result_state":{"const":"NO"},
          "effective_runtime_flags":{
            "required":["outbound_email_enabled","gmail_api_enabled","gmail_inbound_sync_enabled"],
            "properties":{
              "outbound_email_enabled":{"type":"boolean"},
              "gmail_api_enabled":{"const":false},
              "gmail_inbound_sync_enabled":{"const":false}
            }
          },
          "provider_configuration":{
            "required":["outbound_email_provider","inbound_email_provider","mail_provider_vendor"],
            "properties":{
              "outbound_email_provider":{"const":"SMTP"},
              "inbound_email_provider":{"const":"IMAP"},
              "mail_provider_vendor":{"const":"OQUMAIL"}
            }
          }
        }
      }
    }
  ]
}
