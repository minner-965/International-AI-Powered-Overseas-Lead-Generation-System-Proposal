{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpvinternational.local/schemas/current-project-status.schema.json",
  "title": "DPV current project status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_updated_at", "repository", "branch", "commit", "dirty_at_snapshot",
    "latest_released_phase", "current_active_phase", "phase_state",
    "final_acceptance_state", "business_result_state", "applied_migrations",
    "current_real_data_counts", "effective_runtime_flags", "required_n8n_workflow_status",
    "last_reconciliation_heartbeat", "provider_configuration", "current_blockers",
    "next_allowed_work_package", "explicit_stop_boundary"
  ],
  "properties": {
    "generated_updated_at": {"type":"string","format":"date-time"},
    "repository": {"type":"string","minLength":1},
    "branch": {"type":"string","minLength":1},
    "commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "dirty_at_snapshot": {"type":"boolean"},
    "latest_released_phase": {"const":"Phase 9"},
    "current_active_phase": {"const":"Phase 10"},
    "phase_state": {
      "type":"array",
      "minItems":4,
      "items":{"type":"string"},
      "allOf":[
        {"contains":{"const":"Phase 1–9 complete"}},
        {"contains":{"const":"Phase 10 code/migration/UI/automation verified"}},
        {"contains":{"const":"Phase 10 final acceptance incomplete"}},
        {"contains":{"const":"WP-U00–U14 complete"}}
      ]
    },
    "final_acceptance_state": {"const":"INCOMPLETE"},
    "business_result_state": {"const":"NO"},
    "applied_migrations": {
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["migration_key","sha256"],
        "properties":{
          "migration_key":{"type":"string","pattern":"^[0-9]{3}_.+\\.sql$"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        }
      }
    },
    "current_real_data_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "effective_runtime_flags":{"type":"object","additionalProperties":{"type":["boolean","integer","string"]}},
    "required_n8n_workflow_status":{"type":"array","items":{"type":"object"}},
    "last_reconciliation_heartbeat":{
      "type":"object",
      "required":["status","observed_at"],
      "properties":{"status":{"enum":["ACTIVE","STALE","MISSING"]},"observed_at":{"type":["string","null"]}}
    },
    "provider_configuration":{"type":"object"},
    "current_blockers":{"type":"array","items":{"type":"string"}},
    "next_allowed_work_package":{"const":"Gmail controlled acceptance"},
    "explicit_stop_boundary":{"type":"string","pattern":"STOP"}
  }
}
