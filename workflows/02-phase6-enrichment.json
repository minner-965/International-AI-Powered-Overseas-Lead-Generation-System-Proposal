{
  "name": "DPV Phase 6 Buyer and Cooperation Enrichment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dpv-phase6-enrichment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "phase6-webhook",
      "name": "01 Enrichment Job Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [160, 300],
      "webhookId": "adfe98d8-8df8-46c2-b989-104f9e30fe74"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(body.job_id || ''))) throw new Error('Invalid job_id');\nif (String(body.job_type || '') !== 'DECISION_MAKER_ENRICHMENT') throw new Error('Invalid job_type');\nconst markets = Array.isArray(body.market_codes) ? body.market_codes.map(value=>String(value).toUpperCase()) : [];\nconst profiles = Array.isArray(body.product_profiles) ? body.product_profiles.map(value=>String(value).toUpperCase()) : [];\nif (!markets.length || markets.some(value=>!['AE','MX'].includes(value))) throw new Error('Invalid market_codes');\nif (!profiles.length || profiles.some(value=>!['WOMENSWEAR','GENERAL_MERCHANDISE'].includes(value))) throw new Error('Invalid product_profiles');\nreturn [{json:{job_id:String(body.job_id),job_type:'DECISION_MAKER_ENRICHMENT',market_codes:markets,product_profiles:profiles}}];"
      },
      "id": "phase6-validate",
      "name": "02 Validate Enrichment Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_INTERNAL_BASE_URL + '/api/internal/enrichment/jobs/' + $json.job_id + '/run' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.INTERNAL_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{\"wait\":true,\"timeout_ms\":600000}",
        "options": { "timeout": 620000 }
      },
      "id": "phase6-run",
      "name": "03 Run Enrichment Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const result = $json.result || $json;\nreturn [{json:{job_id:$('02 Validate Enrichment Payload').item.json.job_id,status:String(result.status || 'PARTIAL'),result}}];"
      },
      "id": "phase6-result",
      "name": "04 Workflow Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.APP_INTERNAL_BASE_URL + '/api/internal/enrichment/jobs/' + $('02 Validate Enrichment Payload').item.json.job_id + '/status' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.INTERNAL_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{\"status\":\"FAILED\",\"error\":\"Phase 6 enrichment workflow step failed\"}",
        "options": { "timeout": 5000 }
      },
      "id": "phase6-failed",
      "name": "05 Set Job Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 440],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "throw new Error('Phase 6 enrichment workflow failed');"
      },
      "id": "phase6-stop-failed",
      "name": "06 Stop Failed Execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 440]
    }
  ],
  "connections": {
