{
  "name": "DPV Phase 10 Auto Evidence Reconciliation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "phase10-schedule",
      "name": "01 Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [160, 300]
    },
    {
      "parameters": {
        "jsCode": "const enabled=/^(1|true|yes|on)$/i.test(String($env.AUTO_EVIDENCE_ENABLED||'false'));\nconst configured=Number($env.AUTO_EVIDENCE_BATCH_SIZE||10);\nconst batch_size=Number.isFinite(configured)?Math.max(1,Math.min(100,Math.trunc(configured))):10;\nconst market_codes=String($env.AUTO_EVIDENCE_MARKET_CODES||'AE,MX').split(',').map(v=>v.trim().toUpperCase()).filter(v=>['AE','MX'].includes(v));\nconst product_profiles=String($env.AUTO_EVIDENCE_PRODUCT_PROFILES||'WOMENSWEAR,GENERAL_MERCHANDISE').split(',').map(v=>v.trim().toUpperCase()).filter(v=>['WOMENSWEAR','GENERAL_MERCHANDISE'].includes(v));\nconst interval=Math.max(5,Math.min(1440,Number($env.AUTO_EVIDENCE_RECONCILE_MINUTES||30)));\nconst reconcile_bucket=String(Math.floor(Date.now()/(interval*60000)));\nreturn [{json:{enabled,batch_size,market_codes:[...new Set(market_codes)],product_profiles:[...new Set(product_profiles)],reconcile_bucket,schedule_source:'RECONCILIATION'}}];"
      },
      "id": "phase10-config",
      "name": "02 Apply Activation and Bounds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "phase10-enabled-condition",
              "leftValue": "={{ $('02 Apply Activation and Bounds').item.json.enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "phase10-enabled",
      "name": "03 Activation Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_INTERNAL_BASE_URL + '/api/internal/auto-evidence/reconcile' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({batch_size:$('02 Apply Activation and Bounds').item.json.batch_size,market_codes:$('02 Apply Activation and Bounds').item.json.market_codes,product_profiles:$('02 Apply Activation and Bounds').item.json.product_profiles,reconcile_bucket:$('02 Apply Activation and Bounds').item.json.reconcile_bucket,schedule_source:'RECONCILIATION'}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "phase10-reconcile",
      "name": "04 Reconcile Missing Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 240],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{json:{status:'DISABLED',enabled:false,selected:0,scheduled:0,provider_calls:0}}];"
      },
      "id": "phase10-disabled",
      "name": "05 Disabled Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 420]
    },
    {
      "parameters": {
        "jsCode": "throw new Error('Phase 10 auto-evidence reconciliation failed');"
      },
      "id": "phase10-failed",
