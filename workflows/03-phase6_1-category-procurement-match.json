        "jsCode": "const body=$json.body||$json;\nif(!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(body.job_id||''))) throw new Error('Invalid job_id');\nif(String(body.job_type||'')!=='CATEGORY_PROCUREMENT_ENRICHMENT') throw new Error('Invalid job_type');\nconst profiles=Array.isArray(body.product_profiles)?[...new Set(body.product_profiles.map(value=>String(value).toUpperCase()))]:[];\nif(profiles.length!==2||!profiles.includes('WOMENSWEAR')||!profiles.includes('GENERAL_MERCHANDISE')) throw new Error('Both product profiles are required');\nreturn [{json:{job_id:String(body.job_id),job_type:'CATEGORY_PROCUREMENT_ENRICHMENT',product_profiles:profiles}}];"
